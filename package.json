{
  "name": "glide-bi-dashboard-gestion",
  "version": "1.0.0",
  "description": "Dashboard BI para Proyectos de Gestión - Análisis de patrones y seguimiento",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "extract": "node src/scripts/extractData.js",
    "analyze": "node src/scripts/analyzePatterns.js",
    "build": "npm run extract && npm run analyze",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@glideapps/tables": "^1.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
